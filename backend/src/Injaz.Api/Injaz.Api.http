@api = http://localhost:8080
@email = me@example.com
@password = correct-horse-battery

### Health (checks database connectivity)
GET {{api}}/health

### Register → 201, access token in body, refresh token in httpOnly cookie
# @name register
POST {{api}}/api/auth/register
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}", "displayName": "أحمد", "locale": "ar" }

### Login
# @name login
POST {{api}}/api/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

### Who am I (paste the accessToken from login/register)
@accessToken = {{login.response.body.$.accessToken}}
GET {{api}}/api/me
Authorization: Bearer {{accessToken}}

### Update profile (null/omitted = unchanged, "" avatarUrl = remove)
PATCH {{api}}/api/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "locale": "en" }

### Change password (signs out other sessions, returns a fresh one)
PUT {{api}}/api/me/password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "currentPassword": "{{password}}", "newPassword": "another-strong-password" }

### Refresh (uses the cookie; the CSRF header is mandatory)
POST {{api}}/api/auth/refresh
X-Requested-With: XMLHttpRequest

### Logout (revokes this session's refresh tokens and clears the cookie)
POST {{api}}/api/auth/logout
X-Requested-With: XMLHttpRequest

### ---------- Workspaces ----------

### Create a workspace (caller becomes owner)
# @name workspace
POST {{api}}/api/workspaces
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "name": "فريق المنتج" }

### My workspaces
@workspaceId = {{workspace.response.body.$.id}}
GET {{api}}/api/workspaces
Authorization: Bearer {{accessToken}}

### Members
GET {{api}}/api/workspaces/{{workspaceId}}/members
Authorization: Bearer {{accessToken}}

### Invite someone (response contains the one-time token + acceptUrl)
# @name invitation
POST {{api}}/api/workspaces/{{workspaceId}}/invitations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "email": "teammate@example.com", "role": "member" }

### Preview an invitation (no auth needed)
@inviteToken = {{invitation.response.body.$.token}}
GET {{api}}/api/invitations/{{inviteToken}}

### Accept (must be signed in as teammate@example.com)
POST {{api}}/api/invitations/{{inviteToken}}/accept
Authorization: Bearer {{accessToken}}

### ---------- Boards, lists, cards ----------

### Create a board
# @name board
POST {{api}}/api/workspaces/{{workspaceId}}/boards
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "Roadmap", "color": "purple" }

### Add a list
@boardId = {{board.response.body.$.id}}
# @name list
POST {{api}}/api/boards/{{boardId}}/lists
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "To do" }

### Archived lists of the board (restore one with PATCH /api/lists/{id} { "isArchived": false })
GET {{api}}/api/boards/{{boardId}}/lists/archived
Authorization: Bearer {{accessToken}}

### Add a card (position: "bottom" | "top")
@listId = {{list.response.body.$.id}}
# @name card
POST {{api}}/api/lists/{{listId}}/cards
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "Write the spec" }

### Patch a card (omitted = unchanged, null = clear)
@cardId = {{card.response.body.$.id}}
PATCH {{api}}/api/cards/{{cardId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "dueAt": "2026-12-01T17:00:00+03:00", "priority": "high", "description": "## Goals" }

### Move a card (to another list / between neighbours)
POST {{api}}/api/cards/{{cardId}}/move
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "listId": "{{listId}}", "afterId": null, "beforeId": null }

### The whole board
GET {{api}}/api/boards/{{boardId}}
Authorization: Bearer {{accessToken}}

### ---------- Checklist, comments, activity, tasks, search ----------

### Add a checklist item
POST {{api}}/api/cards/{{cardId}}/checklist
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "text": "Outline the sections" }

### Comment
POST {{api}}/api/cards/{{cardId}}/comments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "body": "Draft is in the shared folder." }

### Comments (newest first; pass nextCursor as ?cursor=)
GET {{api}}/api/cards/{{cardId}}/comments?limit=20
Authorization: Bearer {{accessToken}}

### Board activity
GET {{api}}/api/boards/{{boardId}}/activity
Authorization: Bearer {{accessToken}}

### My tasks due today (in Riyadh)
GET {{api}}/api/me/tasks?due=today&tz=Asia/Riyadh
Authorization: Bearer {{accessToken}}

### Search a board
GET {{api}}/api/boards/{{boardId}}/cards?q=spec
Authorization: Bearer {{accessToken}}
