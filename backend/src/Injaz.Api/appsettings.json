{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "injaz",
    "Audience": "injaz",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00"
  },
  "Auth": {
    "RefreshTokenLifetime": "30.00:00:00",
    "RefreshReuseGracePeriod": "00:00:30",
    "RefreshCookie": {
      "Name": "injaz_rt",
      "Path": "/api/auth",
      "Secure": true
    }
  },
  "Invitations": {
    "Lifetime": "7.00:00:00",
    "FrontendBaseUrl": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "CredentialsPermitLimit": 10,
    "CredentialsWindow": "00:01:00"
  }
}
