# /opt/injaz/.env on the server (chmod 600). Never commit the real file.
# Generate secrets with hex so they never contain characters that break the connection string (; = ' "):
#   openssl rand -hex 32     (POSTGRES_PASSWORD)
#   openssl rand -hex 64     (JWT_SIGNING_KEY)

POSTGRES_PASSWORD=
JWT_SIGNING_KEY=

# The Netlify site, exactly as the browser shows it (scheme, no trailing slash). Used for CORS and invite links.
FRONTEND_ORIGIN=https://injaz.jab-eri.org

# Image tag to run. The GitHub deploy exports sha-<commit>; this value is used by manual `docker compose up -d`.
API_VERSION=latest
