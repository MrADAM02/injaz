# Where the built SPA calls the API. Empty = same origin (the dev server proxies /api and /hubs).
# Cloudflare Pages build: https://api.example.com
NUXT_PUBLIC_API_BASE=

# Dev only: the API the dev proxy forwards to (default http://localhost:8080, i.e. docker compose).
# INJAZ_DEV_API=http://localhost:8080
