{
  "name": "injaz-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev --port 3040",
    "dev:lan": "nuxt dev --host --port 3040",
    "build": "nuxt generate",
    "preview": "nuxt preview --port 3040",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "lint:rtl": "node scripts/check-logical-css.mjs",
    "check": "npm run lint:rtl && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@microsoft/signalr": "10.0.11",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "1.0.3",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3",
    "nuxt": "4.6.4",
    "pinia": "4.1.0",
    "sortablejs": "1.15.7",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/sortablejs": "1.15.9",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
